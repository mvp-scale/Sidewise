{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mvp-scale/Sidewise/skills/sidewise/references/request.schema.json",
  "title": "Sidewise request",
  "description": "Two blocks. side: one goal plus plumbing to the TypeSafe classifier. wise: optional context so the ledger learns. Checks JSON Schema can't express (depth matches the yes/no count, numbers unique and 1..N with no gaps, a category holds one kind of question, paths inside the project) are done by the Sidewise validator, which answers '✖ field: problem → fix'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "side"
  ],
  "properties": {
    "side": {
      "$ref": "#/$defs/side"
    },
    "wise": {
      "$ref": "#/$defs/wise"
    }
  },
  "$defs": {
    "line": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[^\\n]*$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 20
    },
    "runId": {
      "type": "string",
      "pattern": "^SW-\\d{4,}$"
    },
    "path": {
      "type": "string",
      "pattern": "^[^\\s:]+(:\\d+(-\\d+)?)?$",
      "description": "a project path, optional :start-end"
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal"
      ],
      "properties": {
        "goal": {
          "$ref": "#/$defs/line",
          "description": "one line: what you want to be true"
        },
        "depth": {
          "enum": [
            "quick",
            "standard",
            "thorough"
          ],
          "description": "quick | standard | thorough. One subject: exactly 10 | 20 | 30 yes/no questions (scale and choice don't count). A sweep: at most 10 | 20 | 30 items per layer"
        },
        "where": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "parent": {
          "$ref": "#/$defs/runId",
          "description": "required by drill and change: the run this builds on"
        },
        "ask": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/tag"
          },
          "description": "one subject: category → pass + questions. A sweep: layer → (category → pass + questions); {layer} blanks are filled in per item",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/category"
              },
              {
                "type": "object",
                "not": {
                  "required": [
                    "pass"
                  ]
                },
                "minProperties": 1,
                "propertyNames": {
                  "$ref": "#/$defs/tag"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/category"
                }
              }
            ]
          }
        },
        "over": {
          "type": "object",
          "description": "sweeps: layer name → items. An item is a string, or {name: <item>, <next-layer>: [...]}. Different items may have different child layers. A layer can also be a path pattern (scan) or 'each' (we split the layer above into functions, calls or steps). Item ids are the names joined by '/': payments/refunds",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/tag"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 30
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "drill: an item id from the parent run (names joined by '/': billing-engine/refunds), or a category name for a one-subject parent"
        },
        "compare": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "before",
            "after"
          ],
          "properties": {
            "before": {
              "type": "string"
            },
            "after": {
              "type": "string"
            }
          },
          "description": "change: two git refs"
        },
        "verb": {
          "enum": [
            "view",
            "class",
            "change",
            "scan",
            "drill",
            "loop"
          ],
          "description": "optional; the tool or command name wins. If both are present and differ, the request is sent back"
        }
      },
      "description": "Per-verb requirements (checked by the validator): class needs depth, where, ask · view needs where (a partial draft is fine) · change needs parent and compare, and never ask (it replays the parent's questions; for new questions, use class) · scan and loop need depth, over, ask · drill needs parent and from; depth is optional. A sweep shows its total question count and cost before any call."
    },
    "category": {
      "type": "object",
      "required": [
        "pass"
      ],
      "properties": {
        "pass": {
          "description": "yes/no questions: yes (each answer ≥ 0.70) or no (each ≤ 0.30). Scale or choice: the passing levels or options",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "yes",
                "no"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "need": {
          "enum": [
            "all",
            "most",
            "any"
          ],
          "default": "all",
          "description": "all: every answer clears the bar · most: ≥ 2/3 and none the wrong way · any: at least one"
        },
        "tags": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/tag"
          }
        }
      },
      "propertyNames": {
        "anyOf": [
          {
            "enum": [
              "pass",
              "need",
              "tags"
            ]
          },
          {
            "pattern": "^[1-9][0-9]*$"
          }
        ]
      },
      "patternProperties": {
        "^[1-9][0-9]*$": {
          "$ref": "#/$defs/question"
        }
      }
    },
    "question": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/line"
            },
            {
              "pattern": "\\?$"
            }
          ],
          "description": "a yes/no question ending in ?"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scale",
            "levels"
          ],
          "properties": {
            "scale": {
              "$ref": "#/$defs/line"
            },
            "levels": {
              "type": "array",
              "minItems": 2,
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "choice",
            "options"
          ],
          "properties": {
            "choice": {
              "$ref": "#/$defs/line"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "wise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "why": {
          "enum": [
            "validate",
            "find",
            "debug"
          ]
        },
        "area": {
          "enum": [
            "data",
            "api",
            "ui",
            "auth",
            "hosting",
            "build",
            "tests"
          ]
        },
        "stage": {
          "enum": [
            "design",
            "build",
            "review",
            "pre-merge",
            "post-fix",
            "release"
          ]
        },
        "change": {
          "enum": [
            "feature",
            "fix",
            "refactor",
            "dependency",
            "config"
          ]
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "parent": {
          "$ref": "#/$defs/runId"
        }
      }
    }
  }
}